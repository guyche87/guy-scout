{
  "name": "guy-scout",
  "version": "0.1.0",
  "private": true,
  "description": "Guy Scout — a web-based, read-only scouting tool for Football Manager 2024, by Guy Chelouche.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "node server/tools/probe.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build:exe": "node scripts/build-exe.mjs",
    "build:lite": "node scripts/build-lite.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "express": "^5.3.0",
    "koffi": "^3.3.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.24.2",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "author": "Guy Chelouche"
}
